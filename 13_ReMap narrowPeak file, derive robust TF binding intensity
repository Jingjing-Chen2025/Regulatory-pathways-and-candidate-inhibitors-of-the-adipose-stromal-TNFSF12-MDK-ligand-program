############################
# 5) PER-PEAK INTENSITY COMPONENTS
############################
dt <- data.table::data.table(
  TF = remap_promoter$TF,
  signalValue = safe_numeric(remap_promoter$signalValue),
  score = safe_numeric(remap_promoter$score),
  width = GenomicRanges::width(remap_promoter),
  name = remap_promoter$name
)
dt[, log_signal    := log1p(signalValue)]
dt[, signal_per_bp := signalValue / width]
dt[!is.finite(signal_per_bp), signal_per_bp := NA_real_]
alpha <- 0.5
dt[, sharpness := signalValue / (width^alpha)]
dt[!is.finite(sharpness), sharpness := NA_real_]

scalers <- NULL
if(use_global_scalers){
  scalers <- .compute_scalers_from_sample(remap_local_override, sample_n=global_scaler_sample_n,
                                          probs=c(0.001,0.999),
                                          min_var=min_scaler_variability,
                                          clip=global_scaler_clip)
}
if(!is.null(scalers)){
  dt[, z_log_signal     := .apply_scaler(log_signal,    scalers$log_signal,   clip=scalers$clip)]
  dt[, z_signal_per_bp  := .apply_scaler(signal_per_bp, scalers$signal_perbp, clip=scalers$clip)]
  dt[, z_sharpness      := .apply_scaler(sharpness,     scalers$sharpness,    clip=scalers$clip)]
  dt[, z_score          := .apply_scaler(score,         scalers$score,        clip=scalers$clip)]
} else {
  dt[, log_signal_w     := winsorize(log_signal)]
  dt[, signal_per_bp_w  := winsorize(signal_per_bp)]
  dt[, sharpness_w      := winsorize(sharpness)]
  dt[, score_w          := winsorize(score)]
  dt[, z_log_signal     := robust_z(log_signal_w)]
  dt[, z_signal_per_bp  := robust_z(signal_per_bp_w)]
  dt[, z_sharpness      := robust_z(sharpness_w)]
  dt[, z_score          := robust_z(score_w)]
  for(col in c("z_log_signal","z_signal_per_bp","z_sharpness","z_score")){
    z <- dt[[col]]
    z[abs(z) > global_scaler_clip] <- global_scaler_clip * sign(z[abs(z) > global_scaler_clip])
    dt[[col]] <- z
  }
}

dt[, z_q := NA_real_]
q_in <- "qValue" %in% colnames(S4Vectors::mcols(remap_promoter))
if (q_in) {
  qv_raw <- safe_numeric(remap_promoter$qValue)
  fin <- is.finite(qv_raw)
  if (sum(fin) >= min_qvalue_finite_needed) {
    if (max(qv_raw[fin], na.rm=TRUE) <= 1) {
      qv_trans <- -log10(qv_raw + 1e-12)
    } else {
      qv_trans <- qv_raw
    }
    if(!is.null(scalers)){
      ctr <- stats::median(qv_trans[fin], na.rm=TRUE)
      mad_val <- stats::mad(qv_trans[fin], constant=1.4826, na.rm=TRUE)
      sd_val  <- stats::sd(qv_trans[fin], na.rm=TRUE)
      if(!is.na(mad_val) && mad_val >= min_scaler_variability){
        z_tmp <- (pmin(pmax(qv_trans, stats::quantile(qv_trans, 0.001, na.rm=TRUE)),
                       stats::quantile(qv_trans, 0.999, na.rm=TRUE)) - ctr) / mad_val
      } else if(!is.na(sd_val) && sd_val >= min_scaler_variability){
        z_tmp <- (pmin(pmax(qv_trans, stats::quantile(qv_trans, 0.001, na.rm=TRUE)),
                       stats::quantile(qv_trans, 0.999, na.rm=TRUE)) - ctr) / sd_val
      } else {
        z_tmp <- rep(NA_real_, length(qv_trans))
      }
    } else {
      qv_w <- winsorize(qv_trans)
      z_tmp <- robust_z(qv_w)
    }
    z_tmp[abs(z_tmp) > global_scaler_clip] <- global_scaler_clip * sign(z_tmp[abs(z_tmp) > global_scaler_clip])
    dt[, z_q := z_tmp]
  } else {
    message("qValue has fewer than ", min_qvalue_finite_needed, " finite values; excluding from composite.")
  }
} else {
  message("qValue column not present; excluding from composite.")
}

dt[, CombCore := rowMeans(cbind(z_log_signal, z_signal_per_bp, z_sharpness, z_score), na.rm=TRUE)]
dt[!is.finite(CombCore), CombCore := NA_real_]
frac_zq <- mean(is.finite(dt$z_q))
if (is.finite(frac_zq) && frac_zq >= 0.8) {
  dt[, CombCorePlus := rowMeans(cbind(CombCore, z_q), na.rm=TRUE)]
  dt[!is.finite(CombCorePlus), CombCorePlus := NA_real_]
  composite_col <- "CombCorePlus"
  message(sprintf("Using CombCorePlus (includes qValue). Finite z_q fraction=%.2f", frac_zq))
} else {
  composite_col <- "CombCore"
  message(sprintf("Using CombCore (signal-derived only). Finite z_q fraction=%.2f", ifelse(is.finite(frac_zq), frac_zq, 0)))
}
selected_composite_name <- composite_col

