.ta_cache_single <- new.env(parent = emptyenv())
get_tagalign_gr_cached <- function(path){
  if(!nzchar(path) || !file.exists(path)) return(GenomicRanges::GRanges())
  key <- normalizePath(path, mustWork=FALSE)
  if(!exists(key, envir=.ta_cache_single, inherits=FALSE)){
    gr <- get_tagalign_gr(path); assign(key, gr, envir=.ta_cache_single)
  }
  get(key, envir=.ta_cache_single, inherits=FALSE)
}
ct_colors <- c(
  adipose_sub="#1f77b4",
  adipose_vis="#2ca02c",
  admsc="#9467bd",
  skeleton_muscle="#8c564b"
)
mark_colors <- c(H3K27ac="#e74c3c", H3K4me1="#f39c12")
make_tf_annotation_track <- function(peaks_gr, genome, chr, name_prefix="", label_color="black", label_cex=0.85){
  if(!length(peaks_gr))
    return(AnnotationTrack(GenomicRanges::GRanges(), genome=genome, chromosome=chr,
                           name=paste0(name_prefix," (no TF peaks)"),
                           background.title="white"))
  peaks_true <- peaks_gr
  bins <- IRanges::disjointBins(GenomicRanges::ranges(peaks_true))
  S4Vectors::mcols(peaks_true)$level <- bins
  S4Vectors::mcols(peaks_true)$group <- S4Vectors::mcols(peaks_true)$TF
  S4Vectors::mcols(peaks_true)$id    <- S4Vectors::mcols(peaks_true)$TF
  tr <- AnnotationTrack(
    peaks_true, genome=genome, chromosome=chr,
    name=name_prefix, feature=S4Vectors::mcols(peaks_true)$TF,
    group=S4Vectors::mcols(peaks_true)$group, id=S4Vectors::mcols(peaks_true)$id,
    stacking="full", showFeatureNames=TRUE, featureAnnotation="id",
    col=label_color, fill=grDevices::adjustcolor(label_color, alpha.f=0.00),
    background.panel="#fafafa", background.title="white"
  )
  displayPars(tr) <- list(
    fontsize=6*label_cex, fontsize.group=6*label_cex,
    fontface=1, fontcolor="black", fontcolor.group="black",
    col=label_color, fill=grDevices::adjustcolor(label_color, alpha.f=0.00),
    lwd=2, stackHeight=2.5
  )
  tr
}
make_histone_datatrack <- function(ct, mark, chr, from, to, tagalign_files, histone_marks,
                                   genome="hg38", color="#e74c3c", max_bins=500L){
  ct_files <- tagalign_files[[ct]]
  if(is.null(ct_files)) return(NULL)
  if(length(ct_files)==length(histone_marks)) names(ct_files) <- histone_marks
  fpath <- ct_files[[mark]]
  if(is.null(fpath) || !file.exists(fpath)) return(NULL)
  tag_gr <- get_tagalign_gr_cached(fpath)
  if(!length(tag_gr)) return(NULL)
  style <- if(grepl("^chr", chr)) "UCSC" else "NCBI"
  try(suppressWarnings(GenomeInfoDb::seqlevelsStyle(tag_gr) <- style), silent=TRUE)
  tag_gr <- tag_gr[as.character(GenomicRanges::seqnames(tag_gr)) == chr]
  if(!length(tag_gr)) return(NULL)
  region <- GenomicRanges::GRanges(chr, IRanges::IRanges(from, to))
  hits <- GenomicRanges::findOverlaps(tag_gr, region, ignore.strand=TRUE)
  tag_gr <- tag_gr[S4Vectors::queryHits(hits)]
  if(!length(tag_gr)) return(NULL)
  cov_list <- GenomicRanges::coverage(tag_gr)
  if(!(chr %in% names(cov_list))) return(NULL)
  cov_chr <- cov_list[[chr]]
  from <- max(1L, as.integer(from)); to <- min(as.integer(to), length(cov_chr))
  if(from>to) return(NULL)
  cov_win <- cov_chr[from:to]
  bin_size <- max(1L, as.integer(ceiling(length(cov_win)/max_bins)))
  starts <- seq.int(1L, length(cov_win), by=bin_size)
  ends <- pmin(starts + bin_size - 1L, length(cov_win))
  means <- as.numeric(IRanges::viewMeans(IRanges::Views(cov_win, starts, ends)))
  gr_bins <- GenomicRanges::GRanges(chr, IRanges::IRanges(from + starts - 1L, from + ends - 1L))
  S4Vectors::mcols(gr_bins)$score <- means
  Gviz::DataTrack(
    range=gr_bins, genome=genome, chromosome=chr, type="histogram",
    name=paste0(ct," ",mark), col.histogram=color, fill.histogram=color,
    ylim=c(0, max(1, max(means, na.rm=TRUE))),
    background.title="white", col.axis="black", col.title="black"
  )
}
plot_promoter_binding_pdf <- function(genes, prom_ranges, remap_tf_peaks, prom_acc_list,
                                      flank=1000L, genome="hg38", pdf_file=tracks_pdf,
                                      cell_types=names(tagalign_files),
                                      show_only_accessible=FALSE, tagalign_files,
                                      histone_marks, marks_to_plot=c("H3K27ac","H3K4me1")){
  pdf(pdf_file, width=11, height=18); on.exit(dev.off(), add=TRUE)
  for(g in genes){
    if(!(g %in% names(prom_ranges))) next
    gp <- prom_ranges[g]; chr <- as.character(GenomicRanges::seqnames(gp))
    from <- max(1, GenomicRanges::start(gp)-flank); to <- GenomicRanges::end(gp)+flank
    axisTrack <- Gviz::GenomeAxisTrack()
    promTrack <- Gviz::AnnotationTrack(gp, genome=genome, name=paste0(g," promoter"),
                                       chromosome=chr, fill="#dddddd", col="#888",
                                       background.title="white")
    tracks_list <- list(axisTrack, promTrack)
    sizes_vec   <- c(0.6, 1.0)
    ov_gene <- GenomicRanges::findOverlaps(remap_tf_peaks, gp, ignore.strand=TRUE)
    gene_tf_peaks <- if(length(ov_gene)) remap_tf_peaks[S4Vectors::queryHits(ov_gene)] else GenomicRanges::GRanges()
    for(ct in cell_types){
      acc_prom <- prom_acc_list[[ct]]
      promoter_accessible <- !is.null(acc_prom) && length(acc_prom) && g %in% names(acc_prom)
      status <- if(promoter_accessible) "TF (acc)" else "TF (not acc)"
      tf_track <- make_tf_annotation_track(
        gene_tf_peaks, genome, chr,
        name_prefix=paste0(ct," ",status),
        label_color=ct_colors[[ct]] %||% "#444444",
        label_cex=0.85
      )
      tracks_list[[length(tracks_list)+1]] <- tf_track
      sizes_vec <- c(sizes_vec, if(length(gene_tf_peaks)) 4.0 else 2.0)
      for(mk in marks_to_plot){
        col <- mark_colors[[mk]] %||% "#999999"
        dt_hist <- try(make_histone_datatrack(ct, mk, chr, from, to, tagalign_files, histone_marks,
                                              genome=genome, color=col), silent=TRUE)
        if(!inherits(dt_hist,"try-error") && !is.null(dt_hist)){
          tracks_list[[length(tracks_list)+1]] <- dt_hist
          sizes_vec <- c(sizes_vec, 1.2)
        }
      }
    }
    grid::grid.newpage()
    grid::pushViewport(grid::viewport(layout=grid::grid.layout(nrow=1, ncol=2,
                                                               widths=grid::unit(c(2.0, 9.0), "inches"))))
    grid::pushViewport(grid::viewport(layout.pos.row=1, layout.pos.col=1))
    grid::grid.rect(gp=grid::gpar(fill="white", col=NA))
    grid::grid.text(paste0(g," promoter"), x=0.5, y=0.95,
                    gp=grid::gpar(fontface="bold", cex=1.1))
    y <- 0.88
    grid::grid.text("Cell types", x=0.5, y=y, gp=grid::gpar(fontface="bold", cex=0.9))
    y <- y - 0.05
    for(ct in cell_types){
      grid::grid.rect(x=0.2, y=y, width=0.25, height=0.04,
                      gp=grid::gpar(fill=ct_colors[[ct]] %||% "#777777", col="grey30"))
      grid::grid.text(ct, x=0.55, y=y, just="left", gp=grid::gpar(cex=0.8))
      y <- y - 0.055
    }
    grid::grid.text("Histone marks", x=0.5, y=y-0.02, gp=grid::gpar(fontface="bold", cex=0.9))
    y <- y - 0.06
    for(mk in c("H3K27ac","H3K4me1")){
      grid::grid.rect(x=0.2, y=y, width=0.25, height=0.04,
                      gp=grid::gpar(fill=mark_colors[[mk]] %||% "#999999", col="grey30"))
      grid::grid.text(mk, x=0.55, y=y, just="left", gp=grid::gpar(cex=0.8))
      y <- y - 0.055
    }
    grid::popViewport()
    grid::pushViewport(grid::viewport(layout.pos.row=1, layout.pos.col=2))
    Gviz::plotTracks(tracks_list,
                     from=from, to=to, chromosome=chr,
                     main=paste0(g," promoter TF binding + histone signals (hg38)"),
                     cex.main=1, background.title="white", sizes=sizes_vec, add=TRUE)
    grid::popViewport(); grid::popViewport()
  }
  message("Promoter binding tracks saved: ", pdf_file)
}
