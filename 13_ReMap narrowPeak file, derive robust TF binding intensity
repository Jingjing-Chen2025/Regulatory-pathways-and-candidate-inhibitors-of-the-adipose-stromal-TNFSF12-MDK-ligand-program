safe_numeric <- function(x, na_tokens=c("NA","NaN","nan",".","","Inf","-Inf")){
  if(is.factor(x)) x <- as.character(x)
  if(!is.character(x)) return(suppressWarnings(as.numeric(x)))
  x <- trimws(x); x[x %in% na_tokens] <- NA_character_
  x <- gsub(",", "", x, fixed=TRUE)
  bad <- !grepl("^[+-]?[0-9]*\\.?[0-9]+([eE][+-]?[0-9]+)?$", x) & !is.na(x)
  if(any(bad)) x[bad] <- NA_character_
  suppressWarnings(as.numeric(x))
}
winsorize <- function(x, probs=c(0.001,0.999)){
  if(all(is.na(x))) return(x)
  q <- stats::quantile(x, probs=probs, na.rm=TRUE)
  pmin(pmax(x, q[1]), q[2])
}
robust_z <- function(x){
  x <- suppressWarnings(as.numeric(x))
  if(all(is.na(x))) return(rep(NA_real_, length(x)))
  fx <- x[is.finite(x)]
  if(!length(fx)) return(rep(NA_real_, length(x)))
  ctr <- stats::median(fx, na.rm=TRUE)
  sc  <- stats::mad(fx, constant=1.4826, na.rm=TRUE)
  if(is.na(sc) || sc==0){
    sc <- stats::sd(fx, na.rm=TRUE); if(is.na(sc) || sc==0) sc <- 1e-8
  }
  z <- (x - ctr)/sc; z[!is.finite(z)] <- NA_real_; z
}
extract_tf <- function(nm){
  tf <- sub("^.*TF=([^;]+).*$","\\1",nm)
  tf2 <- ifelse(tf==nm, sub("_meta.*$","",nm), tf)
  tf3 <- ifelse(tf2==nm, sub("\\s.*$","",tf2), tf2)
  tf3 <- sub("[-|:].*$","",tf3)
  ifelse(nchar(tf3)==0, NA_character_, tf3)
}
qvalue_plausible <- function(qv){
  qv <- qv[is.finite(qv)]; if(!length(qv)) return(FALSE)
  rng <- range(qv, na.rm=TRUE)
  if(rng[1] >= 0 && rng[2] <= 1) return(TRUE)
  if(rng[2] < 1e4) return(TRUE)
  FALSE
}
ensure_bgzip_tabix <- function(in_path){
  bgz <- paste0(in_path,".bgz"); tbi <- paste0(bgz,".tbi")
  if(!file.exists(bgz) || file.mtime(bgz) < file.mtime(in_path)){
    message("bgzip compressing ReMap file ..."); Rsamtools::bgzip(in_path, dest=bgz, overwrite=TRUE)
  }
  if(!file.exists(tbi)){ message("Indexing tabix ..."); Rsamtools::indexTabix(bgz, format="bed") }
  bgz
}

tabix_subset_bed_to_gr <- function(bgz_path, which_gr, flank = 0L,
                                   debug = FALSE, max_lines = Inf) {
  if (!requireNamespace("Rsamtools", quietly = TRUE))
    stop("Rsamtools required.")
  if (!file.exists(bgz_path))
    stop("BGZF not found: ", bgz_path)
  if (is.numeric(flank) && flank > 0L)
    which_gr <- IRanges::resize(which_gr, width = width(which_gr) + 2L * flank, fix = "center")
  tf <- Rsamtools::TabixFile(bgz_path)
  on.exit(try(close(tf), silent = TRUE), add = TRUE)
  idx_seqs <- tryCatch(Rsamtools::seqnamesTabix(tf), error = function(e) character(0))
  if (length(idx_seqs)) {
    style <- if (any(grepl("^chr", idx_seqs))) "UCSC" else "NCBI"
    GenomeInfoDb::seqlevelsStyle(which_gr) <- style
    which_gr <- which_gr[as.character(GenomicRanges::seqnames(which_gr)) %in% idx_seqs]
    if (!length(which_gr)) {
      if (debug) message("[tabix_subset] No query intervals match the index.")
      return(GenomicRanges::GRanges())
    }
  }
  raw_chunks <- Rsamtools::scanTabix(tf, param = which_gr)
  if (!length(raw_chunks)) {
    if (debug) message("[tabix_subset] No lines returned.")
    return(GenomicRanges::GRanges())
  }
  lines <- unique(unlist(raw_chunks, use.names = FALSE))
  if (!length(lines)) {
    if (debug) message("[tabix_subset] Empty after uniqueness filter.")
    return(GenomicRanges::GRanges())
  }
  if (is.finite(max_lines) && length(lines) > max_lines)
    lines <- lines[seq_len(max_lines)]
  df <- tryCatch(
    utils::read.table(text = lines, sep = "\t", header = FALSE,
                      quote = "", comment.char = "", stringsAsFactors = FALSE),
    error = function(e) NULL
  )
  if (is.null(df) || !nrow(df) || ncol(df) < 3) {
    if (debug) message("[tabix_subset] Parsed data invalid.")
    return(GenomicRanges::GRanges())
  }
  colnames(df) <- paste0("V", seq_len(ncol(df)))
  starts <- suppressWarnings(as.integer(df$V2) + 1L)
  ends   <- suppressWarnings(as.integer(df$V3))
  keep   <- is.finite(starts) & is.finite(ends) & (ends >= starts)
  if (!any(keep)) {
    if (debug) message("[tabix_subset] All rows failed coordinate validation.")
    return(GenomicRanges::GRanges())
  }
  df     <- df[keep, , drop = FALSE]
  starts <- starts[keep]; ends <- ends[keep]
  gr <- GenomicRanges::GRanges(df$V1, IRanges::IRanges(starts, ends))
  if (ncol(df) >= 6) {
    s <- ifelse(df$V6 %in% c("+","-"), df$V6, "*")
    GenomicRanges::strand(gr) <- s
  }
  meta_list <- list()
  if (ncol(df) >= 4)  meta_list$name        <- df$V4
  if (ncol(df) >= 5)  meta_list$score       <- suppressWarnings(as.numeric(df$V5))
  if (ncol(df) >= 7)  meta_list$signalValue <- suppressWarnings(as.numeric(df$V7))
  if (ncol(df) >= 8)  meta_list$pValue      <- suppressWarnings(as.numeric(df$V8))
  if (ncol(df) >= 9)  meta_list$qValue      <- suppressWarnings(as.numeric(df$V9))
  if (ncol(df) >= 10) meta_list$peak        <- suppressWarnings(as.integer(df$V10))
  meta_df <- data.frame(meta_list, stringsAsFactors = FALSE, check.names = FALSE)
  if (nrow(meta_df) != length(gr))
    stop("[tabix_subset] Metadata row mismatch: ", nrow(meta_df), " vs GRanges length ", length(gr))
  meta_df <- S4Vectors::DataFrame(meta_df)
  reserved <- c("seqnames","ranges","strand","seqlevels","seqlengths",
                "isCircular","start","end","width","element")
  keep_cols <- setdiff(colnames(meta_df), reserved)
  S4Vectors::mcols(gr) <- meta_df[, keep_cols, drop = FALSE]
  if (length(idx_seqs))
    GenomeInfoDb::seqlevelsStyle(gr) <- if (any(grepl("^chr", idx_seqs))) "UCSC" else "NCBI"
  if (debug) {
    message("[tabix_subset] Returned ", length(gr), " peaks; metadata columns: ",
            paste(colnames(S4Vectors::mcols(gr)), collapse = ", "))
  }
  gr
}

subsetByOverlaps_compat <- function(query, subject, ignore.strand=TRUE, type="any", minoverlap=1L){
  hits <- GenomicRanges::findOverlaps(query, subject, type=type, minoverlap=minoverlap, ignore.strand=ignore.strand)
  if(!length(hits)) return(query[0])
  query[unique(S4Vectors::queryHits(hits))]
}

.compute_scalers_from_sample <- function(remap_path, sample_n=300000L, probs=c(0.001,0.999),
                                         min_var=1e-6, clip=15){
  if(!file.exists(remap_path)) stop("ReMap file not found for scaler computation: ", remap_path)
  dt_bg <- tryCatch(
    data.table::fread(remap_path, sep="\t", header=FALSE, nrows=sample_n, showProgress=FALSE),
    error=function(e) NULL
  )
  if(is.null(dt_bg) || !nrow(dt_bg)) return(NULL)
  if(ncol(dt_bg) < 7) return(NULL)
  if(ncol(dt_bg) > 10) dt_bg <- dt_bg[, 1:10]
  data.table::setnames(dt_bg, paste0("V", seq_len(ncol(dt_bg))))
  width_bg  <- suppressWarnings(as.numeric(dt_bg$V3) - as.numeric(dt_bg$V2))
  width_bg[!is.finite(width_bg) | width_bg <= 0] <- NA_real_
  sig_bg    <- suppressWarnings(as.numeric(dt_bg$V7))
  score_bg  <- suppressWarnings(as.numeric(dt_bg$V5))
  log_bg    <- log1p(sig_bg)
  perbp_bg  <- sig_bg / width_bg
  alpha     <- 0.5
  sharp_bg  <- sig_bg / (width_bg^alpha)
  wz <- function(x){ if(all(is.na(x))) return(x); q <- stats::quantile(x, probs=probs, na.rm=TRUE); pmin(pmax(x,q[1]),q[2]) }
  log_w    <- wz(log_bg); perbp_w <- wz(perbp_bg); sharp_w <- wz(sharp_bg); score_w <- wz(score_bg)
  cs <- function(x){
    fx <- x[is.finite(x)]
    if(!length(fx)) return(list(center=NA_real_, scale=NA_real_))
    ctr <- stats::median(fx, na.rm=TRUE)
    sc  <- stats::mad(fx, constant=1.4826, na.rm=TRUE)
    if(is.na(sc) || sc < min_var){
      sc <- stats::sd(fx, na.rm=TRUE)
      if(is.na(sc) || sc < min_var) return(list(center=ctr, scale=NA_real_))
    }
    list(center=ctr, scale=sc)
  }
  list(
    log_signal   = cs(log_w),
    signal_perbp = cs(perbp_w),
    sharpness    = cs(sharp_w),
    score        = cs(score_w),
    clip         = clip
  )
}

.apply_scaler <- function(x, scaler, probs=c(0.001,0.999), clip=15){
  if(is.null(scaler) || is.na(scaler$center) || is.na(scaler$scale)) return(rep(NA_real_, length(x)))
  if(all(is.na(x))) return(rep(NA_real_, length(x)))
  q <- stats::quantile(x, probs=probs, na.rm=TRUE)
  xw <- pmin(pmax(x, q[1]), q[2])
  z  <- (xw - scaler$center) / scaler$scale
  z[abs(z) > clip] <- clip * sign(z[abs(z) > clip])
  z[!is.finite(z)] <- NA_real_
  z
}

