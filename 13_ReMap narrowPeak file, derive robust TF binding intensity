aggregate_promoter <- function(df){
  if(!nrow(df)) return(data.frame())
  split_list <- split(df, df$TF)
  res <- lapply(split_list, function(sub){
    vals <- sub$Composite[is.finite(sub$Composite)]
    if(!length(vals)){
      return(data.frame(TF=sub$TF[1], PeakCount=0,
                        Promoter_Mean=NA_real_, Promoter_Max=NA_real_,
                        Promoter_Top3=NA_real_, Promoter_Top10p=NA_real_, Promoter_SumPos=NA_real_))
    }
    ord <- sort(vals, decreasing=TRUE)
    top3n <- min(3L, length(vals)); top10n <- max(1L, floor(0.10 * length(vals)))
    data.frame(
      TF = sub$TF[1],
      PeakCount = length(vals),
      Promoter_Mean = mean(vals),
      Promoter_Max  = max(vals),
      Promoter_Top3 = mean(ord[seq_len(top3n)]),
      Promoter_Top10p = mean(ord[seq_len(top10n)]),
      Promoter_SumPos = sum(ord[ord > 0]) / sqrt(length(vals))
    )
  })
  do.call(rbind, res)
}
