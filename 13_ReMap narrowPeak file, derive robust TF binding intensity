add_final_promoter_score <- function(df){
  if(!nrow(df)) return(df)
  robust_vec_z <- function(x){
    x <- as.numeric(x); if(all(is.na(x))) return(rep(NA_real_, length(x)))
    ctr <- stats::median(x, na.rm=TRUE); sc <- stats::mad(x, constant=1.4826, na.rm=TRUE)
    if(is.na(sc) || sc==0){ sc <- stats::sd(x, na.rm=TRUE); if(is.na(sc) || sc==0) sc <- 1e-8 }
    z <- (x - ctr)/sc; z[!is.finite(z)] <- NA_real_; z
  }
  df$z_Top3   <- robust_vec_z(df$Promoter_Top3)
  df$z_Top10p <- robust_vec_z(df$Promoter_Top10p)
  df$z_SumPos <- robust_vec_z(df$Promoter_SumPos)
  df$Promoter_FinalBIS <- rowMeans(cbind(w_top3*df$z_Top3,
                                         w_top10p*df$z_Top10p,
                                         w_sumpos*df$z_SumPos), na.rm=TRUE)
  df[!is.finite(df$Promoter_FinalBIS),"Promoter_FinalBIS"] <- NA_real_
  df
}
