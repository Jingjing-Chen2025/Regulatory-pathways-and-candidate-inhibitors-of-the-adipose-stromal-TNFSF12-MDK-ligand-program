get_tagalign_gr <- function(path){
  if(!file.exists(path)) return(GenomicRanges::GRanges())
  tryCatch(rtracklayer::import(path, format="BED"), error=function(e) GenomicRanges::GRanges())
}
prom_acc_list <- list()
for(ct in names(tagalign_files)){
  ct_files <- tagalign_files[[ct]]
  max_counts_gene <- setNames(integer(length(prom_sel)), names(prom_sel))
  for(f in ct_files){
    gr_tag <- get_tagalign_gr(f); if(!length(gr_tag)) next
    ovp <- subsetByOverlaps_compat(gr_tag, prom_sel, ignore.strand=TRUE, type="any", minoverlap=1L)
    if(!length(ovp)) next
    counts <- GenomicRanges::countOverlaps(prom_sel, ovp); names(counts) <- names(prom_sel)
    max_counts_gene <- pmax(max_counts_gene, counts, na.rm=TRUE)
  }
  accessible <- names(max_counts_gene)[max_counts_gene > min_reads_accessibility]
  prom_acc_list[[ct]] <- if(length(accessible)) prom_sel[names(prom_sel) %in% accessible] else GenomicRanges::GRanges()
}

