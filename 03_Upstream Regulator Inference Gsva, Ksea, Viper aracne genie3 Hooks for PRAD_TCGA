# ---------------- Enrichr (optional) ----------------
run_enrichr_safe <- function(genes, dbs, list_label){
  if (!requireNamespace("enrichR", quietly = TRUE) || length(genes) == 0) return(NULL)
  tryCatch({
    enrichR::setEnrichrSite("Enrichr")
    res_list <- enrichR::enrichr(genes, dbs)
    dplyr::bind_rows(lapply(names(res_list), function(nm){
      tb <- res_list[[nm]]; if (is.null(tb) || !nrow(tb)) return(NULL)
      tibble::as_tibble(tb) %>% dplyr::mutate(Database = nm, list_type = list_label)
    }))
  }, error = function(e){ message("Enrichr error: ", e$message); NULL })
}

# ---------------- ChEA3 (API) ----------------
chea3_query <- function(genes, list_name = "query"){
  if (!length(genes)) return(NULL)
  url <- "https://maayanlab.cloud/chea3/api/enrich/"
  payload <- list(query_name = list_name, gene_set = as.character(genes))
  res <- try(httr::POST(url, body = jsonlite::toJSON(payload, auto_unbox = TRUE),
                        encode = "json", httr::timeout(60)), silent = TRUE)
  if (inherits(res,"try-error") || httr::status_code(res) != 200) return(NULL)
  js <- httr::content(res, as = "parsed", type = "application/json", encoding = "UTF-8")
  out <- list()
  for (nm in names(js)) {
    tb <- try(tibble::as_tibble(js[[nm]], .name_repair = "unique"), silent = TRUE)
    if (!inherits(tb,"try-error") && nrow(tb) > 0) { tb$source <- nm; out[[length(out)+1]] <- tb }
  }
  if (length(out) == 0) NULL else dplyr::bind_rows(out)
}

# ---------------- L1000FWD (signature reversal) ----------------
l1000_sig_search <- function(up, down){
  payload <- list(up_genes = up, down_genes = down)
  for (base in L1000_BASES) {
    resp <- try(httr::RETRY("POST", paste0(base, "sig_search"),
                            body = payload, encode = "json",
                            times = 3, pause_min = 1,
                            terminate_on = c(400,401,403,404),
                            httr::timeout(60)), silent = TRUE)
    if (!inherits(resp, "try-error") && httr::status_code(resp) == 200) {
      js <- jsonlite::fromJSON(httr::content(resp, "text", encoding = "UTF-8"))
      rid <- js$result_id %||% NA_character_
      if (!is.na(rid)) return(list(result_id = rid, base = base))
    }
  }
  list(result_id = NA_character_, base = NA_character_)
}
l1000_fetch_topn <- function(base, result_id){
  if (is.na(result_id) || !nzchar(base)) return(NULL)
  resp <- try(httr::RETRY("GET", paste0(base, "result/topn/", result_id),
                          times = 3, pause_min = 1, httr::timeout(60)), silent = TRUE)
  if (inherits(resp, "try-error") || httr::status_code(resp) != 200) return(NULL)
  jsonlite::fromJSON(httr::content(resp, "text", encoding = "UTF-8"))
}
l1000_fetch_sig <- function(base, sig_id){
  resp <- try(httr::RETRY("GET", paste0(base, "sig/", URLencode(sig_id, reserved = TRUE)),
                          times = 3, pause_min = 0.5, httr::timeout(60)), silent = TRUE)
  if (inherits(resp, "try-error") || httr::status_code(resp) != 200) {
    return(tibble::tibble(sig_id=sig_id, drug_name=NA_character_, pert_id=NA_character_,
                          cell_id=NA_character_, pert_time=NA_real_, pert_dose=NA_real_))
  }
  txt <- httr::content(resp, "text", encoding = "UTF-8")
  txt <- gsub("NaN", "null", txt, fixed = TRUE)
  txt <- gsub("Infinity", "null", txt, fixed = TRUE)
  txt <- gsub("-Infinity", "null", txt, fixed = TRUE)
  js  <- try(jsonlite::fromJSON(txt), silent = TRUE)
  if (inherits(js,"try-error")) {
    return(tibble::tibble(sig_id=sig_id, drug_name=NA_character_, pert_id=NA_character_,
                          cell_id=NA_character_, pert_time=NA_real_, pert_dose=NA_real_))
  }
  tibble::tibble(
    sig_id    = sig_id,
    drug_name = js$pert_desc %||% NA_character_,
    pert_id   = js$pert_id %||% NA_character_,
    cell_id   = js$cell_id %||% NA_character_,
    pert_time = js$pert_time %||% NA_real_,
    pert_dose = js$pert_dose %||% NA_real_
  )
}

# ---------------- Open Targets (GraphQL) ----------------
OT_GQL_query <- function(ensembl_id, page_size = 500L){
  if (is.na(ensembl_id) || !nzchar(ensembl_id)) return(tibble())
  query <- '
  query targetDrugAssociations($ensemblId: String!, $size: Int!) {
    target(ensemblId: $ensemblId) {
      id approvedSymbol
      knownDrugs(page: {index: 0, size: $size}) {
        uniqueDrugs
        rows {
          drugId prefName actionType mechanismOfAction phase status
          disease { id name }
          drug { id name }
          targets { id approvedSymbol }
        }
      }
    }
  }'
  resp <- try(httr::POST(OT_GQL, body = list(
    query = query, variables = list(ensemblId = ensembl_id, size = as.integer(page_size))
  ), encode = "json", httr::timeout(60)), silent = TRUE)
  if (inherits(resp,"try-error") || httr::status_code(resp) != 200) return(tibble())
  js <- jsonlite::fromJSON(httr::content(resp,"text",encoding="UTF-8"), simplifyVector = FALSE)
  rows <- js$data$target$knownDrugs$rows
  if (!length(rows)) return(tibble())
  purrr::map_dfr(rows, function(r){
    tibble::tibble(
      target_ensembl = ensembl_id,
      target_symbol  = js$data$target$approvedSymbol %||% NA_character_,
      drug_id        = r$drugId %||% NA_character_,
      drug_name      = r$prefName %||% (r$drug$name %||% NA_character_),
      action_type    = r$actionType %||% NA_character_,
      moa            = r$mechanismOfAction %||% NA_character_,
      phase          = r$phase %||% NA_integer_,
      status         = r$status %||% NA_character_,
      disease_id     = r$disease$id %||% NA_character_,
      disease_name   = r$disease$name %||% NA_character_,
      drug_clean     = clean_drug(r$prefName %||% (r$drug$name %||% NA_character_))
    )
  }) %>% dplyr::distinct()
}
normalize_ot <- function(df){
  if (is.null(df) || !nrow(df)) {
    return(tibble::tibble(
      drug_clean    = character(),
      target_symbol = character(),
      phase         = integer()
    ))
  }
  need <- c("drug_name","drug_clean","target_symbol","phase")
  for (cc in setdiff(need, names(df))) df[[cc]] <- NA
  if (!"drug_clean" %in% names(df) || all(is.na(df$drug_clean))) {
    base_str <- df$drug_name; base_str[is.na(base_str)] <- ""
    df$drug_clean <- base::toupper(stringr::str_squish(gsub("[^A-Za-z0-9]+"," ", base_str)))
  } else {
    df$drug_clean <- base::toupper(stringr::str_squish(gsub("[^A-Za-z0-9]+"," ", df$drug_clean)))
  }
  df
}

# ---------------- Pathways (FGSEA + PROGENy) ----------------
build_signed_ranks <- function(up, down) {
  up   <- unique(toupper(up));   up   <- up[!is.na(up) & nzchar(up)]
  down <- unique(toupper(down)); down <- down[!is.na(down) & nzchar(down)]
  genes <- unique(c(up, down)); genes <- genes[!is.na(genes) & nzchar(genes)]
  if (!length(genes)) return(numeric(0))
  stats <- rep(0, length(genes)); names(stats) <- genes
  stats[intersect(genes, up)]   <-  1
  stats[intersect(genes, down)] <- -1
  bad <- is.na(names(stats)) | names(stats)=="" | is.na(stats)
  if (any(bad)) stats <- stats[!bad]
  stats
}
run_fgsea_sets <- function(stats, category = "H", subcat = NULL, minSize = 10, maxSize = 500) {
  if (is.null(stats) || !length(stats)) return(NULL)
  bad <- is.na(names(stats)) | names(stats)=="" | is.na(stats)
  if (any(bad)) stats <- stats[!bad]
  if (!length(stats)) return(NULL)

  use_collection <- "collection" %in% names(formals(msigdbr::msigdbr))
  args <- list(species = "Homo sapiens")
  if (use_collection) {
    args$collection <- category
    if (!is.null(subcat)) args$subcategory <- subcat
  } else {
    args$category <- category
    if (!is.null(subcat)) args$subcategory <- subcat
  }
  msig <- try(do.call(msigdbr::msigdbr, args), silent = TRUE)
  if (inherits(msig, "try-error") || is.null(msig) || !nrow(msig)) return(NULL)

  gsets <- split(toupper(msig$gene_symbol), msig$gs_name)
  gsets <- lapply(gsets, function(g) intersect(names(stats), g))
  keep  <- lengths(gsets) >= minSize & lengths(gsets) <= maxSize
  gsets <- gsets[keep]
  if (!length(gsets)) return(NULL)

  suppressWarnings({
    fg <- fgsea::fgsea(pathways = gsets, stats = stats, eps = 1e-6, minSize = minSize, maxSize = maxSize)
  })
  if (is.null(fg) || !nrow(fg)) return(NULL)

  dplyr::as_tibble(fg) %>%
    dplyr::arrange(dplyr::desc(abs(.data$NES))) %>%
    dplyr::mutate(collection = paste0(category, if (!is.null(subcat)) paste0("_", subcat) else ""))
}
run_progeny_signed <- function(stats_signed, top = 500) {
  if (!has_progeny) return(NULL)
  expr <- matrix(stats_signed, ncol = 1)
  rownames(expr) <- names(stats_signed); colnames(expr) <- "pseudo"
  sc <- try(progeny::progeny(t(expr), scale = FALSE, top = top, organism = "Human"), silent = TRUE)
  if (inherits(sc, "try-error") || is.null(sc)) return(NULL)
  tibble::tibble(pathway = rownames(sc), score = as.numeric(sc[, 1])) %>%
    dplyr::arrange(dplyr::desc(abs(.data$score)))
}
safe_rescale <- function(x, from) {
  if (length(from) != 2 || any(!is.finite(from)) || diff(from) == 0) return(rep(0, length(x)))
  scales::rescale(x, to = c(0, 1), from = from)
}

# ---------------- Expression I/O helpers ----------------
.read_expr <- function(path){
  if (is.na(path) || !nzchar(path) || !file.exists(path)) return(NULL)
  message("Loading expression from ", path)
  ext <- tolower(tools::file_ext(path))
  if (ext == "rds") {
    m <- readRDS(path)
  } else if (ext %in% c("csv","tsv","txt")) {
    sep <- if (ext == "csv") "," else "\t"
    m <- read.delim(path, sep = sep, check.names = FALSE, row.names = 1, stringsAsFactors = FALSE)
    m <- as.matrix(m)
  } else {
    stop("Unsupported expr file extension: ", ext)
  }
  storage.mode(m) <- "double"
  m <- m[rowSums(is.na(m)) < ncol(m), , drop = FALSE]
  if (any(duplicated(rownames(m)))) m <- m[!duplicated(rownames(m)), , drop = FALSE]
  m
}
.norm_expr <- function(m, is_log){
  if (is.null(m)) return(NULL)
  if (isTRUE(is_log)) return(m)
  if (!requireNamespace("edgeR", quietly = TRUE)) install.packages("edgeR", repos = "https://cloud.r-project.org")
  suppressPackageStartupMessages(library(edgeR))
  dge <- DGEList(counts = m)
  dge <- calcNormFactors(dge)
  logCPM <- cpm(dge, log = TRUE, prior.count = 1)
  as.matrix(logCPM)
}

# ---------------- TCGA PRAD fallback loader ----------------
.tcga_export_csv <- "TCGA_PRAD_expr_filtered.csv"
load_tcga_prad_expr <- function(){
  cbio <- cBioPortal()
  prad <- cBioDataPack("prad_tcga", ask = FALSE)
  if (!"mrna_seq_v2_rsem" %in% names(experiments(prad))){
    stop("Assay 'mrna_seq_v2_rsem' not found in PRAD TCGA; available: ", paste(names(experiments(prad)), collapse=","))
  }
  expr <- assays(experiments(prad)[["mrna_seq_v2_rsem"]])[[1]]
  expr_cpm  <- edgeR::cpm(expr, log = FALSE)
  expr_log2 <- log2(expr_cpm + 1)
  keep <- rowSums(expr_cpm > 1) >= (0.2 * ncol(expr_cpm))
  expr_filt <- expr_log2[keep, , drop = FALSE]
  utils::write.csv(as.data.frame(expr_filt), .tcga_export_csv)
  message("TCGA PRAD expression loaded & filtered → ", normalizePath(.tcga_export_csv))
  expr_filt
}

# ---------------- CPTAC/PDC phospho (PRAD) for KSEA ----------------
.pdc_endpoint <- "https://pdc.cancer.gov/graphql"
pdc_gql <- function(query, variables = NULL){
  payload <- list(query = query); if (!is.null(variables)) payload$variables <- variables
  resp <- httr::POST(.pdc_endpoint, body = jsonlite::toJSON(payload, auto_unbox = TRUE),
                     encode = "json", httr::add_headers(`Content-Type` = "application/json"))
  httr::stop_for_status(resp)
  out <- jsonlite::fromJSON(httr::content(resp, "text", encoding = "UTF-8"), simplifyVector = FALSE)
  if (!is.null(out$errors)) stop("PDC GraphQL error: ", paste(vapply(out$errors, function(e) e$message, ""), collapse = "; "))
  out$data
}
.pdc_find_prad_studies <- function(){
  q <- "query($program: String!, $disease: String!){ studies(program_name: $program, disease_type: $disease){ pdc_study_id study_name analytical_fraction experiment_type } }"
  dat <- pdc_gql(q, list(program = "CPTAC", disease = "Prostate Adenocarcinoma"))
  tibble::as_tibble(dat$studies)
}
.pdc_list_phospho_files <- function(pdc_study_id){
  q <- "query($sid: String!){ files(pdc_study_id: $sid, data_category: \"Proteome\", data_type: \"Phosphoproteome\"){ file_id file_name md5sum file_size unit data_category data_type file_format download_url } }"
  dat <- pdc_gql(q, list(sid = pdc_study_id))
  tibble::as_tibble(dat$files)
}
.choose_matrix_file <- function(files_df){
  if (is.null(files_df) || !nrow(files_df)) return(NULL)
  cand <- files_df; nm <- tolower(cand$file_name)
  score <- as.numeric(grepl("matrix|aggregat|phospho|site|quant|level", nm))
  if ("file_format" %in% names(cand)) score <- score + ifelse(grepl("tsv|txt", tolower(cand$file_format)), 1, 0)
  cand$.__score <- score
  cand[order(-cand$.__score), ][1, , drop = FALSE]
}
.pdc_download_file <- function(url, outdir = tempdir()){
  if (is.null(url) || is.na(url) || !nzchar(url)) stop("No download_url exposed by PDC for this file.")
  fn <- basename(url); dest <- file.path(outdir, fn)
  utils::download.file(url, destfile = dest, mode = "wb", quiet = TRUE)
  dest
}
.read_phospho_matrix <- function(path){
  first_line <- readLines(path, n = 1)
  delim <- if (grepl("\t", first_line)) "\t" else ","
  df <- tryCatch({ read.delim(path, sep = delim, check.names = FALSE, stringsAsFactors = FALSE) },
                 error = function(e){ read.csv(path, check.names = FALSE, stringsAsFactors = FALSE) })
  df
}
.extract_gene_site <- function(df){
  nms <- tolower(names(df))
  gene_col <- dplyr::first(c(
    names(df)[grepl("^gene$|gene.symbol|hgnc|protein$|uniprot", nms)],
    names(df)[1]
  ))
  site_col <- dplyr::first(c(
    names(df)[grepl("site|modsite|position|phospho|residue", nms)],
    NA
  ))
  gene <- df[[gene_col]]
  site <- if (!is.na(site_col)) df[[site_col]] else NA
  if (all(is.na(site))){
    tmp <- as.character(gene)
    site <- sub(".*[_| ]([STY][0-9]+)$", "\\1", tmp)
    gene <- sub("^([A-Za-z0-9.-]+)[_| ].*$", "\\1", tmp)
  }
  tibble::tibble(GeneSymbol = as.character(gene), Site = toupper(as.character(site)))
}
make_ksea_from_matrix <- function(mat_df, sample_meta = NULL){
  anno_cols <- which(sapply(mat_df, function(x) !is.numeric(x))); if (length(anno_cols) == 0) anno_cols <- 1L
  expr <- as.matrix(mat_df[, -anno_cols, drop = FALSE]); storage.mode(expr) <- "double"
  id_df <- .extract_gene_site(mat_df)
  groups <- NULL
  if (!is.null(sample_meta) && all(c("sample","group") %in% names(sample_meta))){
    mi <- match(colnames(expr), sample_meta$sample); groups <- sample_meta$group[mi]
  }
  val <- NULL
  if (!is.null(groups) && length(unique(na.omit(groups))) == 2){
    glev <- unique(na.omit(groups)); g1 <- which(groups == glev[1]); g2 <- which(groups == glev[2])
    tstat <- apply(expr, 1, function(v){
      x <- v[g1]; y <- v[g2]
      if (length(x) < 2 || length(y) < 2) return(NA_real_)
      ts <- try(stats::t.test(x, y)$statistic, silent = TRUE)
      as.numeric(if (inherits(ts, "try-error")) NA_real_ else ts)
    })
    val <- as.numeric(tstat)
  } else {
    val <- as.numeric(scale(rowMeans(expr, na.rm = TRUE)))
  }
  out <- dplyr::bind_cols(id_df, Value = val)
  out <- out[!is.na(out$Value) & nzchar(out$GeneSymbol) & grepl("^[STY][0-9]+$", out$Site), ]
  out
}
fetch_PRAD_phospho_KSEA <- function(){
  studies <- .pdc_find_prad_studies()
  if (!nrow(studies)) stop("No CPTAC PRAD studies found via PDC.")
  sid <- studies$pdc_study_id[1]
  files <- .pdc_list_phospho_files(sid)
  if (!nrow(files)) stop("No phosphoproteome files found for study ", sid)
  mf <- .choose_matrix_file(files)
  message("Downloading ", mf$file_name, " …")
  loc <- .pdc_download_file(mf$download_url)
  mat <- .read_phospho_matrix(loc)
