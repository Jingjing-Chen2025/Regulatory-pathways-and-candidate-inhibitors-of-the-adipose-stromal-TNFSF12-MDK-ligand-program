# =========================
# 7) GSVA (Hallmarks)
# =========================
GSVA_Hallmarks <- NULL
if (!is.null(expr_filt) && nrow(expr_filt) > 0) {
  msig_h <- msigdbr::msigdbr(species = "Homo sapiens", collection = "H")
  gsets  <- split(toupper(msig_h$gene_symbol), msig_h$gs_name)
  expr_gsva <- as.matrix(expr_filt)
  expr_gsva <- expr_gsva[!duplicated(rownames(expr_gsva)), , drop = FALSE]
  rownames(expr_gsva) <- toupper(rownames(expr_gsva))
  if (anyNA(expr_gsva)) {
    expr_gsva <- t(apply(expr_gsva, 1, function(v){ if(all(is.na(v))) rep(NA_real_, length(v)) else { v[is.na(v)] <- mean(v, na.rm=TRUE); v } }))
    expr_gsva <- expr_gsva[rowSums(is.na(expr_gsva))==0, , drop=FALSE]
  }
  gsets <- lapply(gsets, function(g) intersect(g, rownames(expr_gsva)))
  gsets <- gsets[lengths(gsets) >= 10]
  if (nrow(expr_gsva) > 0 && length(gsets)) {
    gsc <- try(GSEABase::GeneSetCollection(
      mapply(function(genes, nm) GSEABase::GeneSet(setName = nm, geneIds = as.character(genes)),
             gsets, names(gsets), SIMPLIFY = FALSE)
    ), silent = TRUE)

    attempts <- list(
      function(){ GSVA::gsva(exprData = expr_gsva, geneSets = gsc, kcdf = "Gaussian", verbose = FALSE) },
      function(){ GSVA::gsva(geneSets = gsc, exprData = expr_gsva, kcdf = "Gaussian", verbose = FALSE) },
      function(){ GSVA::gsva(expr = expr_gsva, gset.idx.list = gsets, method = "gsva", kcdf = "Gaussian", parallel.sz = 1, verbose = FALSE) },
      function(){ GSVA::gsva(expr = expr_gsva, gset.idx.list = gsets, method = "ssgsea", kcdf = "Gaussian", parallel.sz = 1, verbose = FALSE) }
    )
    gsva_mat <- NULL
    for (fn in attempts) {
      res <- try(fn(), silent = TRUE)
      if (!inherits(res, "try-error")) { gsva_mat <- res; break }
    }
    if (is.null(gsva_mat)) {
      z <- t(scale(t(expr_gsva))); z[!is.finite(z)] <- 0
      sc <- lapply(gsets, function(g){ if (length(g)==0) return(rep(NA_real_, ncol(z))); colMeans(z[g, , drop=FALSE], na.rm = TRUE) })
      gsva_mat <- do.call(rbind, sc); rownames(gsva_mat) <- names(gsets); colnames(gsva_mat) <- colnames(expr_gsva)
    }
    GSVA_Hallmarks <- as.data.frame(gsva_mat) %>% tibble::rownames_to_column("geneset")
  }
}
# =========================
# 8) Regulators: VIPER/ARACNe/GENIE3  (FAST)
# =========================
VIPER_activity <- VIPER_diff <- NULL
if (!is.null(expr_log) && nrow(expr_log) > 0) {
  get_dorothea_regulon <- function(levels = c("A","B","C")){
    dorothea_hs <- dorothea::dorothea_hs
    dorothea_hs %>% dplyr::filter(confidence %in% levels) %>% dorothea::df2regulon()
  }
  regulon_from_aracne <- function(file){
    if (is.na(file) || !nzchar(file) || !file.exists(file)) return(NULL)
    adj <- read.delim(file, header = FALSE, stringsAsFactors = FALSE)
    colnames(adj)[1:3] <- c("tf","target","weight")
    split(adj, adj$tf) |> lapply(function(df){
      list(tfmode = setNames(rep(1, nrow(df)), df$target), likelihood = setNames(df$weight, df$target))
    })
  }

  # --- Speed-optimized GENIE3 wrapper ---
  regulon_from_genie3 <- function(expr_log,
                                  regulators = NULL,
                                  keep_top   = 5000,   # fewer edges returned
                                  max_genes  = 3000,   # stronger prefilter
                                  nTrees     = 200,    # fewer trees
                                  nCores     = NULL,
                                  tf_only    = TRUE,
                                  fallback_if_big = TRUE,
                                  big_threshold   = 4000){
    if (is.null(expr_log)) return(NULL)

    # Early fallback if too large
    if (fallback_if_big && nrow(expr_log) > big_threshold) {
      message("GENIE3 skipped (matrix too large: ", nrow(expr_log), " genes). Using DoRothEA fallback.")
      return(NULL)
    }

    m <- as.matrix(expr_log); storage.mode(m) <- "double"
    m <- m[rowSums(is.na(m)) < ncol(m), , drop = FALSE]
    rn <- rownames(m); if (is.null(rn)) stop("Expression matrix must have rownames for GENIE3.")

    # Collapse duplicated gene IDs by mean
    if (anyDuplicated(rn)) {
      message("GENIE3: collapsing duplicated gene IDs by mean (", sum(duplicated(rn)), " duplicates).")
      summed <- rowsum(m, group = rn, reorder = FALSE, na.rm = TRUE)
      counts <- as.numeric(table(rn)[rownames(summed)]); m <- summed / pmax(counts, 1)
    }

    # Clean remaining non-finite
    m[!is.finite(m)] <- NA_real_
    m <- m[rowSums(is.na(m)) < ncol(m), , drop = FALSE]

    # Regulators: TF-only, intersect with matrix
    regs <- regulators
    if (is.null(regs) && isTRUE(tf_only) && requireNamespace("dorothea", quietly = TRUE)) {
      regs <- base::unique(dorothea::dorothea_hs$tf)
    }
    if (!is.null(regs)) {
      regs <- intersect(regs, rownames(m))
      if (!length(regs)) regs <- NULL
    }

    # Strong variance prefilter (keep most variable genes; always keep regulators)
    if (!is.null(max_genes) && is.finite(max_genes) && nrow(m) > max_genes) {
      vars <- tryCatch({
        if (requireNamespace("matrixStats", quietly = TRUE)) matrixStats::rowVars(m, na.rm = TRUE)
        else apply(m, 1, stats::var, na.rm = TRUE)
      }, error = function(e) apply(m, 1, stats::var, na.rm = TRUE))
      ord <- order(vars, decreasing = TRUE)
      keep_idx <- ord[seq_len(max_genes)]
      keep_genes <- rownames(m)[keep_idx]
      if (!is.null(regs)) keep_genes <- base::unique(c(keep_genes, regs))
      m <- m[keep_genes, , drop = FALSE]
    }

    # Cap cores to avoid overhead
    if (is.null(nCores)) {
      dc <- try(parallel::detectCores(logical = FALSE), silent = TRUE)
      if (inherits(dc, "try-error") || is.na(dc)) dc <- 1L
      nCores <- max(1L, min(4L, as.integer(dc) - 1L))
    }
    if (nCores > 1L && !requireNamespace("doRNG", quietly = TRUE)) {
      message("Package 'doRNG' not found; running GENIE3 with nCores=1."); nCores <- 1L
    }

    nTrees <- as.integer(nTrees)
    message(sprintf("GENIE3 (fast): %d genes (%s regulators); nTrees=%d; nCores=%d",
                    nrow(m), ifelse(is.null(regs), "no", as.character(length(regs))), nTrees, nCores))

    set.seed(1)
    w <- GENIE3::GENIE3(m, regulators = regs, nTrees = nTrees, nCores = nCores)
    links <- GENIE3::getLinkList(w)
    if (!nrow(links)) return(NULL)
    links <- links[order(links$weight, decreasing = TRUE), , drop = FALSE]
    if (!is.null(keep_top) && nrow(links) > keep_top) links <- links[seq_len(keep_top), , drop = FALSE]

    split(links, links$regulatoryGene) |> lapply(function(df){
      list(
        tfmode = setNames(rep(1, nrow(df)), df$targetGene),
        likelihood = setNames(df$weight, df$targetGene)
      )
    })
  }

  # ---------- Build regulon (ARACNe > fast GENIE3 > DoRothEA) ----------
  regulon <- NULL
  if (!is.na(aracne_network_file) && file.exists(aracne_network_file)) {
    regulon <- regulon_from_aracne(aracne_network_file)
  }
  if (is.null(regulon) || !length(regulon)) {
    message("Building GENIE3 regulon (fast settings)…")
    regulon <- regulon_from_genie3(expr_log)
  }
  if (is.null(regulon) || !length(regulon)) {
    message("Falling back to DoRothEA regulon levels A–C…")
    regulon <- get_dorothea_regulon(levels = c("A","B","C"))
  }

  # ---------- VIPER activity / differential ----------
  vp <- viper::viper(eset = expr_log, regulon = regulon, verbose = FALSE)
  if (!is.null(vp)) VIPER_activity <- as.data.frame(vp) %>% tibble::rownames_to_column("TF")

  if (!is.na(sample_groups_csv) && file.exists(sample_groups_csv)) {
    gg <- read.csv(sample_groups_csv, stringsAsFactors = FALSE)
    stopifnot(all(c("sample","group") %in% names(gg)))
    match_idx <- match(colnames(expr_log), gg$sample); groups <- gg$group[match_idx]
    keep <- !is.na(groups)
    if (sum(keep) >= 4 && length(base::unique(groups[keep])) == 2) {
      sig <- viper::rowTtest(expr_log[, keep, drop = FALSE], groups[keep])[,"statistic"]
      names(sig) <- rownames(expr_log)
      mrs <- viper::msviper(sig, regulon, verbose = FALSE)
      res <- viper::summary(mrs)$es$nes
      VIPER_diff <- tibble::tibble(
        tf = names(res), NES = as.numeric(res),
        group_contrast = paste(base::unique(groups[keep])[1], "vs", base::unique(groups[keep])[2])
      )
    }
  }
}
