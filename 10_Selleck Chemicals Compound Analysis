# ========== 3. MATCH APPROVED MEDICINES TO TARGET PROTEINS ==========
cat("\nMatching approved medicines to target proteins...\n")

# Initialize results
matched_medicines <- data.frame()

# Function to check if target matches
match_targets <- function(drug_target, protein_list) {
  # Split multiple targets
  targets <- unlist(str_split(drug_target, "[/,]"))
  targets <- trimws(targets)
  
  # Check for matches
  matches <- protein_list[protein_list %in% targets]
  
  # Special cases for kinase families
  if (length(matches) == 0) {
    if (grepl("CDK", drug_target)) {
      cdk_matches <- protein_list[grep("^CDK", protein_list)]
      matches <- c(matches, cdk_matches)
    }
    if (grepl("MAPK", drug_target)) {
      mapk_matches <- protein_list[grep("^MAPK", protein_list)]
      matches <- c(matches, mapk_matches)
    }
    if (drug_target == "Multiple kinases") {
      # Common targets of multi-kinase inhibitors
      multi_targets <- c("MAPK1", "MAPK3", "SRC", "AKT1", "VEGFR2", "PDGFR")
      matches <- protein_list[protein_list %in% multi_targets]
    }
  }
  
  return(unique(matches))
}

# Match each medicine to targets
for (i in 1:nrow(fda_approved_medicines)) {
  drug <- fda_approved_medicines[i, ]
  
  # Check TFs
  tf_matches <- match_targets(drug$Target, unique_tfs)
  for (tf in tf_matches) {
    matched_medicines <- rbind(matched_medicines, data.frame(
      Generic_Name = drug$Generic_Name,
      Trade_Name = drug$Trade_Name,
      Target = tf,
      Target_Type = "Transcription Factor",
      Approval_Year = drug$Approval_Year,
      Primary_Indication = drug$Primary_Indication,
      stringsAsFactors = FALSE
    ))
  }
  
  # Check Kinases
  kinase_matches <- match_targets(drug$Target, unique_kinases)
  for (kinase in kinase_matches) {
    matched_medicines <- rbind(matched_medicines, data.frame(
      Generic_Name = drug$Generic_Name,
      Trade_Name = drug$Trade_Name,
      Target = kinase,
      Target_Type = "Kinase",
      Approval_Year = drug$Approval_Year,
      Primary_Indication = drug$Primary_Indication,
      stringsAsFactors = FALSE
    ))
  }
}

