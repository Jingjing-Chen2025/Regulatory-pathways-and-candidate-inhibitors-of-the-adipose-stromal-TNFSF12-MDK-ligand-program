chea3_down <- chea3_query(down_genes, "DOWN")

# =========================
# 3) Pathways
# =========================
stats_signed   <- build_signed_ranks(up_genes, down_genes)
fgsea_hallmark <- run_fgsea_sets(stats_signed, category="H")
fgsea_reactome <- run_fgsea_sets(stats_signed, category="C2", subcat="REACTOME")
fgsea_kegg     <- run_fgsea_sets(stats_signed, category="C2", subcat="CP:KEGG")
progeny_scores <- run_progeny_signed(stats_signed, top=500)

# =========================
# 4) L1000FWD reversal
# =========================
sig_info <- l1000_sig_search(up_genes, down_genes)
topn     <- l1000_fetch_topn(sig_info$base, sig_info$result_id)

opposite_tbl <- similar_tbl <- NULL
if (!is.null(topn)) {
  if (!is.null(topn$opposite) && length(topn$opposite) > 0) {
    opp_tmp <- tibble::as_tibble(topn$opposite) %>%
      dplyr::transmute(list_type="opposite", sig_id=as.character(.data$sig_id), score=as.numeric(.data$scores)) %>%
      dplyr::arrange(.data$score)   # more negative = stronger reversal
    opposite_tbl <- head(opp_tmp, l1000_topn)
  }
  if (!is.null(topn$similar) && length(topn$similar) > 0) {
    similar_tbl <- tibble::as_tibble(topn$similar) %>%
      dplyr::transmute(list_type="similar", sig_id=as.character(.data$sig_id), score=as.numeric(.data$scores))
  }
}

opposite_sig_annot <- NULL
if (!is.null(opposite_tbl) && nrow(opposite_tbl) > 0 && nzchar(sig_info$base)) {
  message("Resolving ", nrow(opposite_tbl), " opposite signatures via ", sig_info$base, " ...")
  opposite_sig_annot <- purrr::map_dfr(opposite_tbl$sig_id, function(sid){
    out <- l1000_fetch_sig(sig_info$base, sid); Sys.sleep(0.05); out
  }) %>% dplyr::distinct(.data$sig_id, .keep_all = TRUE)
}

l1000_opposite_signatures <- l1000_opposite_drugs <- NULL
if (!is.null(opposite_tbl) && !is.null(opposite_sig_annot)) {
  l1000_opposite_signatures <- dplyr::inner_join(opposite_tbl, opposite_sig_annot, by="sig_id") %>%
    dplyr::mutate(
      is_confidential = is.na(.data$drug_name) | .data$drug_name == "-666" | !nzchar(.data$drug_name),
      drug_label = dplyr::if_else(.data$is_confidential,
                                  paste0(dplyr::coalesce(.data$pert_id, .data$sig_id, "UNKNOWN"), " (CONFIDENTIAL)"),
                                  .data$drug_name),
      drug_clean = dplyr::if_else(.data$is_confidential,
                                  clean_drug(dplyr::coalesce(.data$pert_id, .data$sig_id, "UNKNOWN")),
                                  clean_drug(.data$drug_name))
    ) %>%
    dplyr::filter(!is.na(.data$drug_clean), nzchar(.data$drug_clean))

  l1000_opposite_drugs <- l1000_opposite_signatures %>%
    dplyr::group_by(.data$drug_clean) %>%
    dplyr::summarise(
      drug_display     = dplyr::first(stats::na.omit(.data$drug_label)),
      any_confidential = any(.data$is_confidential, na.rm=TRUE),
      n_signatures     = dplyr::n(),
      cells            = paste(sort(unique(stats::na.omit(.data$cell_id))), collapse="; "),
      min_score        = min(.data$score, na.rm=TRUE),
      mean_score       = mean(.data$score, na.rm=TRUE),
      median_score     = median(.data$score, na.rm=TRUE),
      doses            = paste(sort(unique(stats::na.omit(.data$pert_dose))), collapse="; "),
      times_h          = paste(sort(unique(stats::na.omit(.data$pert_time))), collapse="; "),
      .groups          = "drop"
    ) %>%
    dplyr::arrange(.data$min_score) %>%
    dplyr::mutate(reversal_strength = -.data$min_score)
}

# =========================
# 5) Open Targets + Cross-evidence
# =========================
ens_tbl  <- to_ensembl(map_targets)
ot_drugs <- dplyr::bind_rows(purrr::map(ens_tbl$ensembl, ot_known_drugs_for_target)) %>%
  dplyr::distinct() %>%
  normalize_ot()

cross_evidence <- NULL
if (!is.null(l1000_opposite_drugs) && nrow(l1000_opposite_drugs) > 0) {
  tgt_summary <- ot_drugs %>%
    dplyr::group_by(.data$drug_clean) %>%
    dplyr::summarise(
      hits_targets = paste(sort(unique(stats::na.omit(.data$target_symbol))), collapse="; "),
      n_targets    = dplyr::n_distinct(stats::na.omit(.data$target_symbol)),
      any_phase    = suppressWarnings(max(.data$phase %||% 0, na.rm=TRUE)),
      .groups      = "drop"
    )
  rng_rev <- range(l1000_opposite_drugs$reversal_strength, na.rm=TRUE)
  rng_tar <- if (nrow(tgt_summary)) c(0, max(tgt_summary$n_targets, na.rm=TRUE)) else c(0,0)
  rng_phs <- if (nrow(tgt_summary)) c(0, max(tgt_summary$any_phase, na.rm=TRUE)) else c(0,0)

  cross_evidence <- l1000_opposite_drugs %>%
    dplyr::left_join(tgt_summary, by="drug_clean") %>%
    dplyr::mutate(
      n_targets = tidyr::replace_na(.data$n_targets, 0L),
      any_phase = tidyr::replace_na(.data$any_phase, 0L),
      rank_score =
        safe_rescale(.data$reversal_strength, rng_rev) +
        0.30 * safe_rescale(.data$n_targets, rng_tar) +
        0.20 * safe_rescale(.data$any_phase, rng_phs)
    ) %>%
    dplyr::arrange(dplyr::desc(.data$rank_score))
}

