# ==============================
# Define regulatory regions based on signal patterns
# ==============================
define_regulatory_regions <- function(binned_data) {
  regions <- list()
  
  # Core Promoter: -2kb to +2kb around TSS with high H3K4me3
  h3k4me3_data <- binned_data %>%
    filter(mark == "H3K4me3", bin >= -2000, bin <= 2000)
  
  if (nrow(h3k4me3_data) > 0) {
    h3k4me3_threshold <- quantile(h3k4me3_data$mean_signal, 0.75, na.rm = TRUE)
    core_promoter <- h3k4me3_data %>%
      filter(mean_signal > h3k4me3_threshold)
    
    if (nrow(core_promoter) > 0) {
      regions$Core_Promoter <- data.frame(
        start = min(core_promoter$bin) + tss_position,
        end = max(core_promoter$bin) + tss_position + bin_size,
        relative_start = min(core_promoter$bin),
        relative_end = max(core_promoter$bin) + bin_size,
        type = "Core_Promoter"
      )
    }
  }
  
  # Active Chromatin: High H3K27ac and ATAC-seq signal
  active_data <- binned_data %>%
    filter(mark %in% c("H3K27ac", "ATAC-seq")) %>%
    group_by(bin) %>%
    summarise(combined_signal = sum(mean_signal, na.rm = TRUE)) %>%
    filter(combined_signal > quantile(combined_signal, 0.7, na.rm = TRUE))
  
  if (nrow(active_data) > 0) {
    active_data <- active_data %>% arrange(bin)
    gaps <- which(diff(active_data$bin) > bin_size)
    start_idx <- c(1, gaps + 1)
    end_idx <- c(gaps, nrow(active_data))
    active_regions <- data.frame()
    for (i in seq_along(start_idx)) {
      region_data <- active_data[start_idx[i]:end_idx[i], ]
      active_regions <- rbind(active_regions, data.frame(
        start = min(region_data$bin) + tss_position,
        end = max(region_data$bin) + tss_position + bin_size,
        relative_start = min(region_data$bin),
        relative_end = max(region_data$bin) + bin_size,
        type = "Active_Chromatin"
      ))
    }
    regions$Active_Chromatin <- active_regions
  }
  
  # Active Enhancer: High H3K4me1 and H3K27ac, low H3K4me3
  enhancer_data <- binned_data %>%
    pivot_wider(names_from = mark, values_from = mean_signal, values_fill = 0) %>%
    filter(!is.na(H3K4me1) & !is.na(H3K27ac) & !is.na(H3K4me3)) %>%
    mutate(enhancer_score = (H3K4me1 + H3K27ac) / (H3K4me3 + 1)) %>%
    filter(enhancer_score > quantile(enhancer_score, 0.8, na.rm = TRUE))
  
  if (nrow(enhancer_data) > 0) {
    enhancer_data <- enhancer_data %>% arrange(bin)
    gaps <- which(diff(enhancer_data$bin) > bin_size)
    start_idx <- c(1, gaps + 1)
    end_idx <- c(gaps, nrow(enhancer_data))
    enhancer_regions <- data.frame()
    for (i in seq_along(start_idx)) {
      region_data <- enhancer_data[start_idx[i]:end_idx[i], ]
      enhancer_regions <- rbind(enhancer_regions, data.frame(
        start = min(region_data$bin) + tss_position,
        end = max(region_data$bin) + tss_position + bin_size,
        relative_start = min(region_data$bin),
        relative_end = max(region_data$bin) + bin_size,
        type = "Active_Enhancer"
      ))
    }
    regions$Active_Enhancer <- enhancer_regions
  }
  
  return(regions)
}

# Identify regulatory regions
regulatory_regions <- define_regulatory_regions(binned_data)
all_regions <- bind_rows(regulatory_regions)

if (nrow(all_regions) > 0) {
  all_regions$chromosome <- chromosome
  all_regions <- dplyr::select(all_regions, chromosome, start, end, relative_start, relative_end, type)
}

